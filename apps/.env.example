NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cost_buildup_user
POSTGRES_PASSWORD=password
POSTGRES_DB=cost_buildup_db
DATABASE_URL=postgresql://cost_buildup_user:password@localhost:5432/cost_buildup_db

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=30d

MINIO_ENDPOINT=localhost
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_BUCKET=costbuildup-documents

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Optional Telegram Bot API delivery. Configure a numeric Telegram chat ID per
# user in User Management after each user has started the bot.
TELEGRAM_BOT_TOKEN=

ERP_BASE_URL=http://localhost:3001
ERP_API_KEY=mock_erp_key
